# ──────────────────────────────────────────────────────────────
# Sahayak — Environment variables (EXAMPLE)
# ──────────────────────────────────────────────────────────────
# HOW THIS WORKS:
# 1. This file (".env.example") is a SAFE TEMPLATE — it has no real secrets,
#    so it CAN be committed to GitHub. Recruiters see what your app needs.
# 2. You COPY it to ".env" (which is gitignored) and fill in real values.
# 3. Your app reads ".env" at runtime. The real ".env" never reaches GitHub.
#
# Do this now:  cp .env.example .env
# ──────────────────────────────────────────────────────────────

# ── Database ──
# Docker Compose reads these to set up Postgres credentials.
POSTGRES_USER=sahayak
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=sahayak
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# The full connection string your FastAPI app uses.
# Note: the host is "postgres" (the Docker service name), NOT "localhost",
# because inside Docker the app talks to the other container by its name.
DATABASE_URL=postgresql+psycopg://sahayak:changeme_local_only@postgres:5432/sahayak

# ── App ──
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# ── LLM API keys (we'll add these in a later sprint) ──
# Get a free key at https://aistudio.google.com/
GEMINI_API_KEY=
# Optional fallback: https://console.groq.com/
GROQ_API_KEY=
